---
import { percorso } from "../lib/percorsi";
import "../styles/global.css";
import SkipLink from "../components/SkipLink.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TornaSu from "../components/TornaSu.astro";
import { schemaPsychologist, schemaWebSite } from "../lib/jsonld";
import { fotoPer } from "../lib/foto";
import { getImage } from "astro:assets";
import { site } from "../config/site";

interface Props {
  title: string;
  description: string;
  /** Impedisce l'indicizzazione (admin, 404, pagine di servizio). */
  noindex?: boolean;
  /** Blocchi JSON-LD aggiuntivi. Gli schemi Psychologist e WebSite sono già inclusi di default. */
  jsonLd?: Record<string, unknown>[];
  /** Disattiva lo schema Psychologist automatico (solo per pagine noindex come admin). */
  senzaSchemaOrganizzazione?: boolean;
}

const {
  title,
  description,
  noindex = false,
  jsonLd = [],
  senzaSchemaOrganizzazione = false,
} = Astro.props;

const titoloCompleto = title.includes("Elisa Castigliego")
  ? title
  : `${title} — Dott.ssa Elisa Castigliego, Psicologa a San Lazzaro di Savena (BO)`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const urlHome = new URL(percorso("/"), Astro.site).href;

// Su build di anteprima (es. GitHub Pages mentre il sito vero è su Netlify)
// PUBLIC_NOINDEX=on impedisce l'indicizzazione di tutto, per non creare
// contenuti duplicati nei motori di ricerca.
const nascondiAiMotori = noindex || import.meta.env.PUBLIC_NOINDEX === "on";

// Immagine per l'anteprima nei social/messaggistica (og:image): la foto di
// "Mi presento" ritagliata 1200×630, se presente. Senza foto il tag è omesso.
const fotoRitratto = fotoPer("mi-presento");
const immagineSocial = fotoRitratto
  ? new URL(
      (
        await getImage({
          src: fotoRitratto,
          width: 1200,
          height: 630,
          fit: "cover",
          position: "top",
          format: "jpeg",
        })
      ).src,
      Astro.site,
    ).href
  : undefined;

const jsonLdCompleto = senzaSchemaOrganizzazione
  ? jsonLd
  : [
      schemaPsychologist({
        urlHome,
        descrizione: description,
        immagine:
          immagineSocial ?? new URL(percorso("/favicon.svg"), Astro.site).href,
      }),
      schemaWebSite(urlHome),
      ...jsonLd,
    ];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={percorso("/favicon.svg")} />

    <title>{titoloCompleto}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.nomeConTitolo} />
    <meta name="theme-color" content="#FBF6F0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={percorso("/sitemap-index.xml")} />

    {
      nascondiAiMotori ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nomeConTitolo} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="it_IT" />
    {
      immagineSocial && (
        <>
          <meta property="og:image" content={immagineSocial} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={site.nomeConTitolo} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={immagineSocial ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={titoloCompleto} />
    <meta name="twitter:description" content={description} />
    {immagineSocial && <meta name="twitter:image" content={immagineSocial} />}

    {
      jsonLdCompleto.map((blocco) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(blocco)}
        />
      ))
    }
  </head>
  <body
    class="flex min-h-screen flex-col bg-[var(--color-bg)] text-[var(--color-text)]"
  >
    <SkipLink />
    <Header />
    <main id="contenuto" class="flex-1">
      <slot />
    </main>
    <Footer />
    <TornaSu />
  </body>
</html>
