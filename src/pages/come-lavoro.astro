---
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pagine", "come-lavoro");
const { Content } = await render(entry!);
---

<Layout title={entry!.data.seoTitle} description={entry!.data.seoDescription}>
  <article
    class="mx-auto max-w-[var(--content-max-width)] px-4 py-10 sm:px-6 sm:py-16"
  >
    <h1
      class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-4xl"
    >
      {entry!.data.titolo}
    </h1>
    <div class="prose-content mt-6">
      <Content />
    </div>
  </article>
</Layout>
