---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { schemaFaqPage } from "../lib/jsonld";

const faqEntries = (await getCollection("faq")).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);
const conContenuto = await Promise.all(
  faqEntries.map(async (entry) => ({ entry, rendered: await render(entry) })),
);

const jsonLdFaq = schemaFaqPage(
  faqEntries.map((entry) => ({
    domanda: entry.data.domanda,
    risposta: (entry.body ?? "").trim(),
  })),
);
---

<Layout
  title="Domande frequenti"
  description="Risposte alle domande più frequenti su primo colloquio, durata, frequenza, riservatezza e modalità online o in studio."
  jsonLd={[jsonLdFaq]}
>
  <section
    class="mx-auto max-w-[var(--content-max-width)] px-4 py-10 sm:px-6 sm:py-16"
  >
    <h1
      class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-4xl"
    >
      Domande frequenti
    </h1>
    <p
      class="mt-3 max-w-[var(--prose-max-width)] text-[var(--color-text-muted)]"
    >
      Alcune risposte alle domande più comuni prima di un primo contatto. Per
      qualsiasi altra domanda, scrivi tramite la <a
        class="underline"
        href="/contatti">pagina contatti</a
      >.
    </p>

    <dl
      class="mt-8 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]"
    >
      {
        conContenuto.map(({ entry, rendered }) => (
          <div class="py-5">
            <dt class="font-[family-name:var(--font-heading)] text-lg font-semibold text-[var(--color-text)]">
              {entry.data.domanda}
            </dt>
            <dd class="prose-content mt-2 text-[var(--color-text-muted)]">
              <rendered.Content />
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
