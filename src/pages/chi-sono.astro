---
import Layout from "../layouts/Layout.astro";
import RitrattoElisa from "../components/RitrattoElisa.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pagine", "chi-sono");
const { Content } = await render(entry!);
---

<Layout title={entry!.data.seoTitle} description={entry!.data.seoDescription}>
  <article
    class="mx-auto max-w-[var(--content-max-width)] px-4 py-10 sm:px-6 sm:py-16"
  >
    <div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_16rem] sm:items-start">
      <div>
        <h1
          class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-4xl"
        >
          {entry!.data.titolo}
        </h1>
        <div class="prose-content mt-6">
          <Content />
        </div>
      </div>
      <div class="mx-auto w-40 sm:w-full">
        <RitrattoElisa
          variant="quadrata"
          class="w-full rounded-[var(--radius-lg)] shadow-[var(--shadow-card)]"
        />
      </div>
    </div>
  </article>
</Layout>
