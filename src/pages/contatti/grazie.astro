---
import { percorso } from "../../lib/percorsi";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Messaggio inviato"
  description="Il tuo messaggio è stato inviato correttamente."
  noindex
>
  <section
    class="mx-auto max-w-[var(--content-max-width)] px-4 py-16 sm:px-6 sm:py-24"
  >
    <div class="mx-auto max-w-[var(--prose-max-width)] text-center">
      <h1
        class="font-[family-name:var(--font-heading)] text-4xl leading-tight font-medium tracking-tight text-[var(--color-text)] sm:text-5xl"
      >
        Messaggio inviato
      </h1>
      <p class="mt-4 text-[var(--color-text-muted)]">
        Grazie per aver scritto, ti contatterò il prima possibile! Per
        situazioni urgenti, consulta la pagina
        <a class="underline" href={percorso("/emergenze")}>emergenze</a>.
      </p>
      <a
        class="mt-8 inline-flex min-h-[var(--touch-target-min)] items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-primary)] px-6 py-3 font-semibold text-[var(--color-primary-contrast)] hover:bg-[var(--color-primary-hover)]"
        href={percorso("/")}
      >
        Torna alla home
      </a>
    </div>
  </section>
</Layout>
