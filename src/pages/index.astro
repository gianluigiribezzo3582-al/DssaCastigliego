---
import { percorso } from "../lib/percorsi";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import tegoleTerracotta from "../assets/sfondi/tegole-terracotta.jpg";

const homeEntry = await getEntry("pagine", "home");

// Foto delle sezioni: src/assets/foto/<id-sezione>.<estensione>, es.
// src/assets/foto/mi-presento.jpg. Se il file manca la build non si rompe:
// al suo posto compare un riquadro neutro "Foto in arrivo".
const fotoDisponibili = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/foto/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}",
  { eager: true },
);
function fotoPer(id: string): ImageMetadata | undefined {
  const percorso = Object.keys(fotoDisponibili).find(
    (p) =>
      p
        .split("/")
        .pop()!
        .replace(/\.[^.]+$/, "") === id,
  );
  return percorso ? fotoDisponibili[percorso].default : undefined;
}

const sezioni = await Promise.all(
  (await getCollection("sezioni"))
    .sort((a, b) => a.data.ordine - b.data.ordine)
    .map(async (sezione) => ({
      id: sezione.id,
      data: sezione.data,
      foto: fotoPer(sezione.id),
      Content: (await render(sezione)).Content,
    })),
);
---

<Layout
  title={homeEntry!.data.seoTitle}
  description={homeEntry!.data.seoDescription}
>
  <section class="relative overflow-hidden bg-[var(--color-bg-alt)]">
    <Image
      src={tegoleTerracotta}
      alt=""
      width={1600}
      height={900}
      loading="eager"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-[0.07]"
    />
    <div
      class="relative mx-auto max-w-[var(--content-max-width)] px-4 py-14 text-center sm:px-6 sm:py-20"
    >
      <h1
        class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-5xl"
      >
        {homeEntry!.data.titolo}
      </h1>
      <p class="mt-3 text-lg text-[var(--color-text-muted)]">
        {homeEntry!.data.sottotitolo}
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={percorso("/contatti")}>Contattami</Button>
      </div>
    </div>
  </section>

  {
    sezioni.map((sezione, indice) => (
      <section
        id={sezione.id}
        aria-labelledby={`titolo-${sezione.id}`}
        class={`scroll-mt-4 py-12 sm:py-20 ${indice % 2 === 1 ? "bg-[var(--color-bg-alt)]" : ""}`}
      >
        <div class="mx-auto grid max-w-[var(--content-max-width)] items-center gap-8 px-4 sm:px-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12">
          <figure
            class={`mx-auto w-full max-w-sm ${indice % 2 === 1 ? "md:order-2" : ""}`}
          >
            {sezione.foto ? (
              <Image
                src={sezione.foto}
                alt={sezione.data.altFoto ?? ""}
                width={800}
                class="aspect-[4/5] w-full rounded-[var(--radius-lg)] object-cover shadow-[var(--shadow-card)]"
              />
            ) : (
              <div class="flex aspect-[4/5] w-full items-center justify-center rounded-[var(--radius-lg)] border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] text-sm text-[var(--color-text-muted)]">
                Foto in arrivo
              </div>
            )}
            {sezione.data.didascaliaFoto && (
              <figcaption class="mt-2 text-center text-xs text-[var(--color-text-muted)] italic">
                {sezione.data.didascaliaFoto}
              </figcaption>
            )}
          </figure>
          <div>
            <h2
              id={`titolo-${sezione.id}`}
              class="font-[family-name:var(--font-heading)] text-2xl font-semibold text-[var(--color-text)] sm:text-3xl"
            >
              {sezione.data.titolo}
            </h2>
            <div class="prose-content mt-5">
              <sezione.Content />
            </div>
          </div>
        </div>
        {indice === sezioni.length - 1 && (
          <div class="mt-8 flex justify-center px-4 sm:mt-10">
            <Button href={percorso("/contatti")}>Scrivimi</Button>
          </div>
        )}
      </section>
    ))
  }
</Layout>
