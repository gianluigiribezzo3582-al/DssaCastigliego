---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Pagina non trovata"
  description="La pagina richiesta non esiste o è stata spostata."
  noindex
>
  <section class="mx-auto max-w-[var(--content-max-width)] px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-[var(--prose-max-width)] text-center">
      <h1
        class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-4xl"
      >
        Pagina non trovata
      </h1>
      <p class="mt-4 text-[var(--color-text-muted)]">
        La pagina che cerchi non esiste o è stata spostata. Puoi tornare alla home o
        andare direttamente ai contatti.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          class="inline-flex min-h-[var(--touch-target-min)] items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-primary)] px-6 py-3 font-semibold text-[var(--color-primary-contrast)] hover:bg-[var(--color-primary-hover)]"
          href="/"
        >
          Torna alla home
        </a>
        <a
          class="inline-flex min-h-[var(--touch-target-min)] items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-primary)] px-6 py-3 font-semibold text-[var(--color-primary)] hover:bg-[var(--color-bg-alt)]"
          href="/contatti"
        >
          Vai ai contatti
        </a>
      </div>
    </div>
  </section>
</Layout>
