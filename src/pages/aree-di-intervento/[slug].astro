---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { schemaBreadcrumb } from "../../lib/jsonld";

export async function getStaticPaths() {
  const aree = await getCollection("aree");
  return aree.map((area) => ({
    params: { slug: area.id },
    props: { area },
  }));
}

const { area } = Astro.props;
const { Content } = await render(area);

const dominio = Astro.site?.origin ?? "";
const breadcrumb = schemaBreadcrumb(dominio, [
  { nome: "Home", percorso: "/" },
  { nome: "Aree di intervento", percorso: "/aree-di-intervento" },
  { nome: area.data.titolo, percorso: `/aree-di-intervento/${area.id}` },
]);
---

<Layout
  title={area.data.seoTitle ?? area.data.titolo}
  description={area.data.seoDescription ?? area.data.riassunto}
  jsonLd={[breadcrumb]}
>
  <article
    class="mx-auto max-w-[var(--content-max-width)] px-4 py-10 sm:px-6 sm:py-16"
  >
    <nav
      aria-label="Percorso di navigazione"
      class="mb-6 text-sm text-[var(--color-text-muted)]"
    >
      <a class="underline hover:text-[var(--color-primary)]" href="/">Home</a>
      <span aria-hidden="true"> / </span>
      <a
        class="underline hover:text-[var(--color-primary)]"
        href="/aree-di-intervento">Aree di intervento</a
      >
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{area.data.titolo}</span>
    </nav>

    <h1
      class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-4xl"
    >
      {area.data.titolo}
    </h1>
    <div class="prose-content mt-6">
      <Content />
    </div>

    <p class="mt-10">
      <a
        class="font-semibold text-[var(--color-primary)] underline"
        href="/contatti"
      >
        Scrivi per un primo contatto →
      </a>
    </p>
  </article>
</Layout>
