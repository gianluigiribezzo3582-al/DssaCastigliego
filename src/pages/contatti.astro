---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Mail from "@lucide/astro/icons/mail";
import MapPin from "@lucide/astro/icons/map-pin";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Phone from "@lucide/astro/icons/phone";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import { site, whatsappHref } from "../config/site";

// Su un hosting solo statico (GitHub Pages) la Function /api/contatto non esiste:
// il workflow imposta PUBLIC_MODULO_CONTATTO=off e al posto del modulo compare
// l'invito a scrivere via email, così nessun messaggio va perso.
const moduloAttivo = import.meta.env.PUBLIC_MODULO_CONTATTO !== "off";
---

<Layout
  title="Contatti"
  description="Scrivi tramite il modulo di contatto o via email. Studio a San Lazzaro di Savena (Bologna), colloqui solo in presenza."
>
  <section
    class="mx-auto max-w-[var(--content-max-width)] px-4 py-10 sm:px-6 sm:py-16"
  >
    <h1
      class="font-[family-name:var(--font-heading)] text-3xl font-semibold text-[var(--color-text)] sm:text-4xl"
    >
      Contatti
    </h1>
    <p
      class="mt-3 max-w-[var(--prose-max-width)] text-[var(--color-text-muted)]"
    >
      {
        moduloAttivo
          ? "Puoi scrivermi tramite il modulo qui sotto oppure direttamente via email."
          : "Puoi scrivermi direttamente via email: ti risponderò il prima possibile."
      }
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div
        class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-card)] sm:p-8"
      >
        {
          moduloAttivo ? (
            <ContactForm />
          ) : (
            <div class="text-[var(--color-text)]">
              <h2 class="font-[family-name:var(--font-heading)] text-xl font-semibold">
                Scrivimi via email
              </h2>
              <p class="mt-3">
                <a
                  class="inline-flex items-center gap-2 text-lg font-semibold text-[var(--color-primary)] underline"
                  href={`mailto:${site.contatti.email}`}
                >
                  <Mail aria-hidden="true" size={20} />
                  {site.contatti.email}
                </a>
              </p>
              <p class="mt-4 rounded-[var(--radius-md)] bg-[var(--color-bg-alt)] p-3 text-sm">
                Per tutelare la tua riservatezza, non inserire informazioni sul
                tuo stato di salute. Le approfondiremo insieme nel primo
                colloquio.
              </p>
            </div>
          )
        }
      </div>

      <aside class="space-y-6">
        <div>
          <h2 class="text-sm font-semibold text-[var(--color-text)]">
            Contatti diretti
          </h2>
          <ul class="mt-2 space-y-2 text-sm text-[var(--color-text-muted)]">
            <li>
              <a
                class="inline-flex items-center gap-1.5 underline hover:text-[var(--color-primary)]"
                href={`mailto:${site.contatti.email}`}
              >
                <Mail aria-hidden="true" size={15} />
                {site.contatti.email}
              </a>
            </li>
            <li>
              <a
                class="inline-flex items-center gap-1.5 underline hover:text-[var(--color-primary)]"
                href={`mailto:${site.contatti.pec}`}
              >
                <ShieldCheck aria-hidden="true" size={15} />
                {`PEC: ${site.contatti.pec}`}
              </a>
            </li>
            {
              site.contatti.telefono && (
                <li>
                  <a
                    class="inline-flex items-center gap-1.5 underline hover:text-[var(--color-primary)]"
                    href={`tel:${site.contatti.telefono}`}
                  >
                    <Phone aria-hidden="true" size={15} />
                    {site.contatti.telefono}
                  </a>
                </li>
              )
            }
            {
              whatsappHref && (
                <li>
                  <a
                    class="inline-flex items-center gap-1.5 underline hover:text-[var(--color-primary)]"
                    href={whatsappHref}
                    rel="noopener"
                  >
                    <MessageCircle aria-hidden="true" size={15} />
                    Scrivi su WhatsApp
                  </a>
                  <p class="mt-1 text-xs">
                    Solo per appuntamenti e questioni pratiche, non per
                    contenuti clinici.
                  </p>
                </li>
              )
            }
          </ul>
        </div>

        <div>
          <h2
            class="flex items-center gap-1.5 text-sm font-semibold text-[var(--color-text)]"
          >
            <MapPin aria-hidden="true" size={15} />
            Studio
          </h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">
            {site.localita}
          </p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">
            Colloqui solo in presenza.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>
