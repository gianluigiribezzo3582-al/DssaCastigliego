---
import { percorso } from "../lib/percorsi";
import Menu from "@lucide/astro/icons/menu";
import { site } from "../config/site";

// Le prime tre voci sono ancore verso le sezioni della home (vedi
// src/content/sezioni): non hanno uno stato "pagina corrente".
const voci = [
  { href: percorso("/#mi-presento"), label: "Mi presento" },
  { href: percorso("/#di-cosa-mi-occupo"), label: "Di cosa mi occupo" },
  { href: percorso("/#la-mia-formazione"), label: "La mia formazione" },
  { href: percorso("/contatti"), label: "Contatti" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes("#") && path.startsWith(href);
---

<header
  class="relative border-b border-[var(--color-border)] bg-[var(--color-bg)]"
>
  <div
    class="mx-auto flex max-w-[var(--content-max-width)] items-center justify-between gap-4 px-4 py-4 sm:px-6 md:py-5"
  >
    <a href={percorso("/")} class="group text-[var(--color-text)]">
      <span
        class="block font-[family-name:var(--font-heading)] text-lg leading-tight font-medium sm:text-xl"
      >
        {site.nomeConTitolo}
      </span>
      <span class="etichetta mt-1 block text-[0.6875rem]">
        {site.titoloProfessionale}
      </span>
    </a>

    <nav aria-label="Principale">
      <!-- Mobile: funziona anche senza JavaScript grazie a <details>/<summary> -->
      <details class="md:hidden">
        <summary
          class="flex min-h-[var(--touch-target-min)] min-w-[var(--touch-target-min)] cursor-pointer list-none items-center justify-center gap-2 border border-[var(--color-text)] px-3 py-2 text-xs font-semibold tracking-[0.14em] text-[var(--color-text)] uppercase [&::-webkit-details-marker]:hidden"
        >
          <Menu aria-hidden="true" size={16} />
          Menu
        </summary>
        <ul
          class="absolute inset-x-0 z-30 mt-4 border-y border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-2"
        >
          {
            voci.map((voce) => (
              <li class="border-b border-[var(--color-border)] last:border-b-0">
                <a
                  href={voce.href}
                  aria-current={isActive(voce.href) ? "page" : undefined}
                  class="block py-4 font-[family-name:var(--font-heading)] text-xl text-[var(--color-text)] aria-[current=page]:text-[var(--color-primary)] aria-[current=page]:italic"
                >
                  {voce.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <!-- Desktop -->
      <ul class="hidden items-center gap-7 md:flex">
        {
          voci.map((voce) => (
            <li>
              <a
                href={voce.href}
                aria-current={isActive(voce.href) ? "page" : undefined}
                class="py-2 text-xs font-semibold tracking-[0.14em] text-[var(--color-text)] uppercase decoration-[var(--color-primary)] decoration-1 underline-offset-[6px] hover:underline aria-[current=page]:text-[var(--color-primary)] aria-[current=page]:underline"
              >
                {voce.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
