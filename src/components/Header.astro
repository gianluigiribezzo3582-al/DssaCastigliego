---
import Menu from "@lucide/astro/icons/menu";

const voci = [
  { href: "/", label: "Home" },
  { href: "/chi-sono", label: "Chi sono" },
  { href: "/aree-di-intervento", label: "Aree di intervento" },
  { href: "/come-lavoro", label: "Come lavoro" },
  { href: "/faq", label: "Domande frequenti" },
  { href: "/contatti", label: "Contatti" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-bg)]">
  <div
    class="mx-auto flex max-w-[var(--content-max-width)] items-center justify-between gap-4 px-4 py-4 sm:px-6"
  >
    <a
      href="/"
      class="font-[family-name:var(--font-heading)] text-lg font-semibold text-[var(--color-text)] sm:text-xl"
    >
      Elisa Castigliego
      <span
        class="block text-xs font-normal text-[var(--color-text-muted)] sm:text-sm"
      >
        Psicologa · Bologna
      </span>
    </a>

    <nav aria-label="Principale">
      <!-- Mobile: funziona anche senza JavaScript grazie a <details>/<summary> -->
      <details class="relative md:hidden">
        <summary
          class="flex min-h-[var(--touch-target-min)] min-w-[var(--touch-target-min)] cursor-pointer list-none items-center justify-center gap-1.5 rounded-[var(--radius-md)] border border-[var(--color-border)] px-3 py-2 text-[var(--color-text)] [&::-webkit-details-marker]:hidden"
        >
          <Menu aria-hidden="true" size={18} />
          Menu
        </summary>
        <ul
          class="absolute right-0 z-20 mt-2 w-56 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] p-2 shadow-[var(--shadow-card)]"
        >
          {
            voci.map((voce) => (
              <li>
                <a
                  href={voce.href}
                  aria-current={isActive(voce.href) ? "page" : undefined}
                  class="block rounded-[var(--radius-sm)] px-3 py-2 text-[var(--color-text)] hover:bg-[var(--color-bg-alt)] aria-[current=page]:font-semibold aria-[current=page]:text-[var(--color-primary)]"
                >
                  {voce.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <!-- Desktop -->
      <ul class="hidden items-center gap-1 md:flex">
        {
          voci.map((voce) => (
            <li>
              <a
                href={voce.href}
                aria-current={isActive(voce.href) ? "page" : undefined}
                class="rounded-[var(--radius-sm)] px-3 py-2 text-[var(--color-text)] hover:bg-[var(--color-bg-alt)] aria-[current=page]:font-semibold aria-[current=page]:text-[var(--color-primary)]"
              >
                {voce.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
