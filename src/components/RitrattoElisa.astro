---
// Punto unico da cui passa il ritratto di Elisa in tutto il sito.
//
// Di default mostra src/assets/placeholder.jpeg (ottimizzato automaticamente da
// Astro: WebP, dimensioni per variante). Se dal CMS viene caricata una foto
// (campo "Foto del ritratto" nella sezione "Contatti e dati dello studio" di
// /admin, salvata in site.fotoRitratto), viene mostrata quella al suo posto —
// senza bisogno di modifiche al codice. In quel caso l'immagine non passa dalla
// pipeline di ottimizzazione di Astro (i file caricati dal CMS vivono in
// public/, non in src/assets, e Astro non può ottimizzare a tempo di build un
// percorso che cambia a piacere): è il compromesso scelto per rendere la foto
// editabile da Elisa senza intervento di uno sviluppatore. Vedi /docs/ASSETS.md
// e /docs/DECISIONI.md.
import { Image } from "astro:assets";
import placeholder from "../assets/placeholder.jpeg";
import { site } from "../config/site";

interface Props {
  /** Inquadratura richiesta dal layout che la usa. */
  variant: "verticale" | "quadrata" | "piccola";
  /** Testo alternativo: provvisorio, va riscritto con Elisa prima della pubblicazione. */
  alt?: string;
  class?: string;
  /** Se true, l'immagine è puramente decorativa in quel contesto (alt vuoto). */
  decorative?: boolean;
  loading?: "lazy" | "eager";
}

const {
  variant,
  alt = "Ritratto provvisorio — foto segnaposto, in attesa della fotografia definitiva di Elisa Castigliego",
  class: className = "",
  decorative = false,
  loading = "lazy",
} = Astro.props;

const dimensioni = {
  verticale: { width: 720, height: 960 }, // 3:4 — home
  quadrata: { width: 640, height: 640 }, // 1:1 — chi sono
  piccola: { width: 240, height: 240 }, // 1:1 — contatti
} as const;

const { width, height } = dimensioni[variant];
const altFinale = decorative ? "" : alt;
const fotoCaricataDalCms = site.fotoRitratto?.trim();
---

{
  fotoCaricataDalCms ? (
    <img
      src={fotoCaricataDalCms}
      alt={altFinale}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class={`object-cover ${className}`}
    />
  ) : (
    <Image
      src={placeholder}
      alt={altFinale}
      width={width}
      height={height}
      loading={loading}
      class={`object-cover ${className}`}
    />
  )
}
