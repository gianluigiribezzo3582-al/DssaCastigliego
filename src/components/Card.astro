---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = "" } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class={`block rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-card)] ${href ? "transition-transform duration-[var(--motion-duration)] hover:-translate-y-0.5" : ""} ${className}`}
>
  <slot />
</Tag>
