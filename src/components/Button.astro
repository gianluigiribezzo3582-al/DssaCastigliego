---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary";
  class?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex min-h-[var(--touch-target-min)] items-center justify-center gap-3 rounded-[var(--radius-sm)] px-6 py-3 text-sm font-semibold tracking-[0.08em] uppercase transition-colors duration-[var(--motion-duration)]";

const varianti = {
  primary:
    "bg-[var(--color-primary)] text-[var(--color-primary-contrast)] hover:bg-[var(--color-primary-hover)]",
  secondary:
    "border border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-bg-alt)]",
};

const classi = `${base} ${varianti[variant]} ${className}`;
const Tag = href ? "a" : "button";
---

<Tag href={href} type={href ? undefined : type} class={classi} {...rest}>
  <slot />
  <span class="freccia" aria-hidden="true">→</span>
</Tag>
